\@writefile{toc}{\contentsline {paragraph}{Primary frozen analysis.}{2}{section*.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Finite-scale, rank-conditioned association between curvature and local probe error. Left: controlled $\rho (K_{H}^{\mathrm  {cross}},R^{2}_{\mathrm  {local}})$ versus chart rank for the primary $n{=}512$, $k{=}2048$ analysis (line, simultaneous 95\% band). Markers show $n{=}128$ scale estimates; $k{=}512$ is marked unreliable. The top axis is held-out $R^{2}_{L}$. Shading: FWER-negative span $d{=}16$--$20$ in the primary analysis. Right: percentile relationship between $K_{H}^{\mathrm  {cross}}$ and OOF MSE at the predeclared representative rank $d{=}16$ (primary $n{=}512$, $k{=}2048$). Catalog magnitude and DESI labels are not shown.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:curv}{{2}{3}{Finite-scale, rank-conditioned association between curvature and local probe error. Left: controlled $\rho (K_{H}^{\mathrm {cross}},R^{2}_{\mathrm {local}})$ versus chart rank for the primary $n{=}512$, $k{=}2048$ analysis (line, simultaneous 95\% band). Markers show $n{=}128$ scale estimates; $k{=}512$ is marked unreliable. The top axis is held-out $R^{2}_{L}$. Shading: FWER-negative span $d{=}16$--$20$ in the primary analysis. Right: percentile relationship between $K_{H}^{\mathrm {cross}}$ and OOF MSE at the predeclared representative rank $d{=}16$ (primary $n{=}512$, $k{=}2048$). Catalog magnitude and DESI labels are not shown}{figure.2}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Chart rank is evaluated by held-out reconstruction, not a single eigengap. Left: pooled linear and regularised quadratic NMSE versus chart rank ($k{=}2048$). Right: pooled $R^{2}_{L}$ and its increment. Shading marks the \emph  {evaluated chart range} $d{=}12$--$20$ ($\tau {\approx }0.80$ and $0.85$). Linear NMSE is still falling at $d{=}20$; no vertical line is drawn at a putative intrinsic dimension.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:dim}{{1}{2}{Chart rank is evaluated by held-out reconstruction, not a single eigengap. Left: pooled linear and regularised quadratic NMSE versus chart rank ($k{=}2048$). Right: pooled $R^{2}_{L}$ and its increment. Shading marks the \emph {evaluated chart range} $d{=}12$--$20$ ($\tau {\approx }0.80$ and $0.85$). Linear NMSE is still falling at $d{=}20$; no vertical line is drawn at a putative intrinsic dimension}{figure.1}{}}
